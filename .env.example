# =============================================================================
# Pro Reward Hub - production environment
# Copy this file to `.env` (next to docker-compose.yml) and fill in real
# values. NEVER commit the real .env file.
#   cp .env.example .env && nano .env
# =============================================================================

# NOTE: TLS/HTTPS is handled by the EXISTING shared Caddy container on this VPS
# (prochannelhelpbot-caddy-1), not by this stack. There is no DOMAIN / ACME_EMAIL
# here because Pro Reward Hub does not run its own Caddy. The public domain
# (prorewardhub.org) is configured in the shared Caddyfile — see DEPLOYMENT.md.

# ---- PostgreSQL -------------------------------------------------------------
# These create the database inside the `db` container and are combined into
# DATABASE_URL automatically by docker-compose.
POSTGRES_USER=prohub
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=prohub

# ---- Better Auth ------------------------------------------------------------
# Must be the exact public HTTPS URL of the site. This is both the auth base
# URL and a trusted origin in production.
BETTER_AUTH_URL=https://prorewardhub.org
# Random secret of at least 32 chars. Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-run-openssl-rand-base64-32

# ---- Resend (email notifications) -------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# The verified sending domain in Resend (e.g. prorewardhub.org or mail.prorewardhub.org).
RESEND_EMAIL_DOMAIN=prorewardhub.org

# ---- Telegram login ---------------------------------------------------------
# Bot token from @BotFather (kept server-side for signature verification).
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Bot username WITHOUT the leading @. NOTE: this is inlined into the client
# bundle at BUILD time, so changing it requires a rebuild
# (docker compose up -d --build).
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourBotUsername
